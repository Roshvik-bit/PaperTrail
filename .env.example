# ==========================================
# PAPERTRAIL ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database / Supabase
# If left empty, PaperTrail falls back to in-memory research repository with persistence options.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scholarly Data Sources (Optional API keys for increased rate limits)
# OpenAlex works without a key (polite pool via email is recommended)
OPENALEX_EMAIL=researcher@example.edu
# Semantic Scholar API key (recommended for higher throughput)
SEMANTIC_SCHOLAR_API_KEY=
# Crossref mailto header for polite pool
CROSSREF_MAILTO=researcher@example.edu

# TinyFish Autonomous Research Discovery
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.ai/v1

# LLM Providers (Multi-provider abstraction: Gemini, Anthropic, OpenAI, or local/fallback)
# If no key is set, PaperTrail uses an intelligent deterministic rule-based scientific inference
# engine with curated knowledge extraction for verifiable benchmarking.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Processing & Safety Limits
MAX_PAPERS_PER_SESSION=50
MAX_FULLTEXT_PROCESS_COUNT=10
CITATION_EXPANSION_DEPTH=2
RESEARCH_BUDGET_USD=5.00

